[Unit]
Description=Telegram Credit Bot (worker)
After=network.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/telebot-1
ExecStart=/home/ubuntu/telebot-1/venv/bin/python3 bot.py
Restart=always
RestartSec=5
EnvironmentFile=/home/ubuntu/telebot-1/.env
StandardOutput=append:/home/ubuntu/telebot-1/logs/bot.log
StandardError=append:/home/ubuntu/telebot-1/logs/bot.log

[Install]
WantedBy=multi-user.target